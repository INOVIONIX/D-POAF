      { "label": "quality-1", "description": "PA Quality Rating: 1 (poor — must refine)" },
      { "label": "quality-2", "description": "PA Quality Rating: 2 (below par — must refine)" },
      { "label": "quality-3", "description": "PA Quality Rating: 3 (acceptable)" },
      { "label": "quality-4", "description": "PA Quality Rating: 4 (good — reusable candidate)" },
      { "label": "quality-5", "description": "PA Quality Rating: 5 (excellent — reusable)" }
