        "applies_to": ["wave"]
      },
      {
        "label": "prompt-action",
        "description": "Identifies the issue as a Prompt Action (Task)",
        "applies_to": ["prompt-action"]
      },
      {
        "label": "proof-record",
        "description": "Identifies the issue as a Proof Record (Sub-task)",
        "applies_to": ["proof-record"]
      }
    ],
    "wave_profile": [
      {
        "label": "deliver-wave",
        "description": "Profile: short-term, output-focused Wave"
      },
      {
        "label": "decide-wave",
        "description": "Profile: decision-making Wave (architecture, scoping)"
      },
      {
        "label": "control-wave",
        "description": "Profile: governance/compliance Wave"
      },
      {
        "label": "delegate-wave",
        "description": "Profile: handoff to another team/Wave"
      },
      {
        "label": "operate-wave",
        "description": "Profile: ongoing operational responsibility"
      }
    ],
    "macro_phase": [
      {
        "label": "macro-1",
        "description": "Wave is in Macro-Phase 1 — Instruct & Scope",
        "color_suggestion": "blue"
      },
      {
        "label": "macro-2",
        "description": "Wave is in Macro-Phase 2 — Shape & Align",
        "color_suggestion": "yellow"
      },
      {
        "label": "macro-3",
        "description": "Wave is in Macro-Phase 3 — Execute & Evolve",
        "color_suggestion": "purple"
