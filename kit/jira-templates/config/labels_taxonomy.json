      { "label": "phase-1", "description": "Sub-Phase 1 — Intent & Scope" },
      { "label": "phase-2", "description": "Sub-Phase 2 — Contextualize & Extract" },
      { "label": "phase-3", "description": "Sub-Phase 3 — Design Prompt Actions" },
      { "label": "phase-4", "description": "Sub-Phase 4 — Build & Generate" },
      { "label": "phase-5", "description": "Sub-Phase 5 — Coordinate & Validate" },
      { "label": "phase-6", "description": "Sub-Phase 6 — Deliver & Monitor" },
      { "label": "phase-7", "description": "Sub-Phase 7 — Feedback & Evolve" }
