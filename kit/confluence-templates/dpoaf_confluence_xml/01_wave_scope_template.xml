    </td></tr>
    <tr><th>Repository URL</th><td><ac:placeholder>e.g., https://github.com/myorg/myrepo</ac:placeholder></td></tr>
    <tr><th>Working Branch</th><td><ac:placeholder>e.g., feature/WAVE-2026-001</ac:placeholder></td></tr>
    <tr><th>Release Tag (at close)</th><td><ac:placeholder>e.g., v1.4.0 — fill at Wave close</ac:placeholder></td></tr>
  </tbody>
</table>

